# Токен вашего Telegram-бота (от @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Бесплатный ключ Groq (для распознавания голоса и продуктов)
# Получить бесплатно тут: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Ключи разработчика FatSecret Platform API
# Получить тут: https://platform.fatsecret.com
FATSECRET_CONSUMER_KEY=your_fatsecret_consumer_key_here
FATSECRET_CONSUMER_SECRET=your_fatsecret_consumer_secret_here

# Numeric Telegram USER IDs, separated by commas. Empty/invalid values block startup.
# Only private chats are accepted. All allowed users share ONE FatSecret account.
ALLOWED_TELEGRAM_IDS=

# Optional existing HTTP CONNECT proxy. Leave empty for direct connections.
# In Docker on Linux: http://host.docker.internal:8118
# Native execution: http://127.0.0.1:8118
TELEGRAM_PROXY=
OUTBOUND_PROXY=
