# Токен вашего Telegram-бота (от @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Бесплатный ключ Groq (для распознавания голоса и продуктов)
# Получить бесплатно тут: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Ключи разработчика FatSecret Platform API
# Получить тут: https://platform.fatsecret.com
FATSECRET_CONSUMER_KEY=your_fatsecret_consumer_key_here
FATSECRET_CONSUMER_SECRET=your_fatsecret_consumer_secret_here
